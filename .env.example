# ============================================================
# RouteRadio keys — English-only for now
# Copy to .env  (never commit the real file)
# ============================================================

# --- REQUIRED for smart global narration (pick ONE) ---
# Phone GPS + OpenStreetMap already name the village.
# Without an AI key the host can only read Wikipedia/OSM text.
ANTHROPIC_API_KEY=          # Claude
OPENAI_API_KEY=             # GPT
GEMINI_API_KEY=             # Gemini 2.0 Flash — current default
LLM_PROVIDER=gemini         # claude | openai | gemini

# --- OPTIONAL voice (otherwise the phone speaks for free) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# OPENAI_API_KEY also unlocks OpenAI TTS if ElevenLabs is empty

# --- OPTIONAL maps upgrade (OSM Nominatim is free, no key) ---
MAPBOX_ACCESS_TOKEN=

# --- OPTIONAL cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_DIR=./storage

HOST_VOICE_TONE=warm, concise, never salesy
DEFAULT_LOCALE=en
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Mobile: only the backend URL. Do not put AI keys on the phone. ---
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO_ROUTE=peja-istog
